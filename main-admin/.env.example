# ---- MySQL (Database Connection) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
# Control-plane database (main admin)
DB_NAME=nuadmin

# ---- Auth (JWT Secret) ----
JWT_SECRET=nuadmin-9f3c1a7d5e8b42c6a0d4f1e7b9c2d8e4
JWT_EXPIRES_IN=12h

# ---- Generator Settings ----
# Where standalone sub-admin projects are materialised
TENANTS_ROOT=/config/nuadmin/tenants
# Sub-admin databases are named `${DB_TENANT_PREFIX}<slug>`
DB_TENANT_PREFIX=nuadmin_t_
# ---- Server & Port Registry / 端口规划与速查指引 ----
# Main Admin 主控制台端口（默认：10000）
PORT=10000
HOST=0.0.0.0

# Sub Admin 子后台端口分配池（默认联动 PORT+1：10001 ~ 10999）
TENANT_PORT_FROM=10001
TENANT_PORT_TO=10999

# ==============================================================================
# 【AI 与用户协作端口速查与分配指引 (Port Registry for AI & User)】
# 1. 主控制台 (Main Admin): http://localhost:10000
# 2. 子后台 (Sub Admin) 默认分配规则:
#    - 默认从 10001 开始按创建顺序自动递增分配空闲端口 (10001, 10002, 10003...)
#    - AI 在调用 genplus-build Skill 立项时，应告知用户默认端口（如 http://localhost:10001），
#      并提示：“若需自定义端口，可直接回复如‘端口使用 10086’”。
# 3. 用户自主指定端口方式:
#    - 通过 MCP 工具 `genplus_create_tenant` 传入 `port: <number>` 参数；
#    - 或在 POST /api/tenant 请求体中传入 `port: <number>`；
#    - 系统会自动校验端口合法性 (1024~65535)、防主后台冲突、防租户库冲突与宿主机动态探活。
# ==============================================================================
