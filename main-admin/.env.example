# ---- MySQL (Database Connection) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
# Control-plane database (main admin)
DB_NAME=nuadmin

# ---- Auth (JWT Secret) ----
JWT_SECRET=nuadmin-9f3c1a7d5e8b42c6a0d4f1e7b9c2d8e4
JWT_EXPIRES_IN=12h

# ---- Generator Settings ----
# Where standalone sub-admin projects are materialised
TENANTS_ROOT=/config/nuadmin/tenants
# Sub-admin databases are named `${DB_TENANT_PREFIX}<slug>`
DB_TENANT_PREFIX=nuadmin_t_
# Port range assigned to generated sub-admins
TENANT_PORT_FROM=7100
TENANT_PORT_TO=7199

# ---- Server ----
PORT=6005
HOST=0.0.0.0
